name: "mshaders"
displayName: "Mindustry Shaders"
author: "REDEagle0705, Claude"
description: "Visual effects only: water with reflections, ice and ground effects, directional block shadows, lights that blocks and units stop, metal glint, hand-drawn normal maps that light blocks and units by calculation, engines of units as streaks of light, and a colour pass. Every effect can be switched off in Settings > Shaders. Client-side, adds no content. Desktop and Android. Tested on v160.7."
version: "0.1.6"
main: "mshaders.ShaderMod"
minGameVersion: "160"
java: true
hidden: true
